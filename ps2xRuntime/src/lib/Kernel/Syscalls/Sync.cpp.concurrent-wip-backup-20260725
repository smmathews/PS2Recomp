    // Diagnostic: dump every live sema's id/count/maxCount/waiters + parked
    // tids. See Sync.h. Snapshots under g_sema_map_mutex, then logs outside
    // the lock (matches the sema->waitList swap-then-log pattern used
    // elsewhere in this file, e.g. DeleteSema above).
    void dumpSemaWaitLists(const char *reasonTag)
    {
        struct Row
        {
            int id;
            int count;
            int maxCount;
            int waiters;
            std::vector<int> waitingTids;
        };
        std::vector<Row> rows;
        {
            std::lock_guard<std::mutex> mapLock(g_sema_map_mutex);
            rows.reserve(g_semas.size());
            for (const auto &[id, info] : g_semas)
            {
                if (!info) continue;
                Row row{id, 0, 0, 0, {}};
                {
                    std::lock_guard<std::mutex> semaLock(info->m);
                    row.count = info->count;
                    row.maxCount = info->maxCount;
                    row.waiters = info->waiters;
                    row.waitingTids.reserve(info->waitList.size());
                    for (const auto &[tid, token] : info->waitList)
                    {
                        (void)token;
                        row.waitingTids.push_back(tid);
                    }
                }
                rows.push_back(std::move(row));
            }
        }
        std::sort(rows.begin(), rows.end(), [](const Row &a, const Row &b) { return a.id < b.id; });
        std::cout << "[dq8][semadump] reason=" << (reasonTag ? reasonTag : "?")
                  << " count=" << rows.size() << std::endl;
        for (const Row &row : rows)
        {
            std::cout << "[dq8][semadump]   sid=" << row.id
                      << " count=" << row.count
                      << " max=" << row.maxCount
                      << " waiters=" << row.waiters
                      << " waitingTids=[";
            for (size_t i = 0; i < row.waitingTids.size(); ++i)
            {
                if (i) std::cout << ",";
                std::cout << row.waitingTids[i];
            }
            std::cout << "]" << std::endl;
        }
    }
